# Backend environment variables (copy to .env — never commit secrets)

PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=https://nexora-coding.vercel.app

# Preferred: OpenAI (used first if present)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Fallback if OPENAI_API_KEY is not set
GOOGLE_AI_KEY=your_gemini_api_key

# Optional — logout token blacklist. App still works if Redis is down.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
